{
  "_note": "scripts/copy_lint.py 의 임계값. 사실·렌더 무결성은 gates.json, 이 파일은 카피의 자연스러움·저장가치를 다룬다. 기본은 권고(warn/info)이며 --strict 일 때만 warn 이 실패한다.",
  "version": "1.0",
  "headline": {
    "maxQuestionRatio": 0.2,
    "maxSingleFormShare": 0.5
  },
  "takeaway": {
    "maxNegativeCardRatio": 0.3,
    "maxFormalEndingRatio": 0.85,
    "maxSameEndingRun": 4
  },
  "statute": {
    "maxPerCard": 1,
    "coverAllowed": false
  },
  "cover": {
    "requirePayoff": true
  },
  "placeholders": [
    "출처 입력",
    "TODO",
    "TBD",
    "XXX",
    "{{",
    "lorem ipsum",
    "[미확인]"
  ],
  "negation": {
    "ko": "(아닙니다|않습니다|없습니다|수는 없|못합니다)[.!]?$",
    "en": "\\b(not|no|never|doesn't|does not|don't|cannot|isn't|aren't|won't)\\b"
  },
  "statuteRef": {
    "ko": "제\\d+조(?:의\\d+)?(?:제\\d+항)?",
    "en": "Article\\s+\\d+(?:-\\d+)?(?:\\(\\d+\\))?"
  },
  "payoff": {
    "ko": "\\d+\\s*(?:가지|개|단계|질문|장|분|초)|(?:두|세|네|다섯|여섯|일곱|여덟|아홉|열)\\s*가지|체크리스트",
    "en": "\\b(?:\\d+|one|two|three|four|five|six|seven|eight|nine|ten)\\s+(?:questions|steps|checks|things|rules|criteria|ways|points|signs|roles|triggers|conditions|factors)\\b|checklist"
  },
  "saveCue": {
    "ko": "저장|다시 보|보관|북마크",
    "en": "save|bookmark|come back|keep this"
  },
  "style": {
    "_note": "반복·번역투·영문 가독성. 모두 info(권고)이며 --strict에서도 실패로 치지 않는다. 글을 막지 않고 윤문할 곳을 알려 주는 용도다.",
    "ko": {
      "connectors": [
        "따라서",
        "즉",
        "또한",
        "특히",
        "결국",
        "하지만",
        "그러나",
        "다만",
        "그래서"
      ],
      "stockPhrases": [
        "중요한 것은",
        "중요한 점",
        "중요합니다",
        "핵심은",
        "살펴보겠습니다",
        "알아보겠습니다",
        "주의해야 합니다",
        "필요가 있습니다",
        "라고 할 수 있습니다",
        "것이 좋습니다",
        "판단해서는 안 됩니다"
      ],
      "translationese": [
        "에 있어서",
        "을 통해",
        "를 통해",
        "에 대해서",
        "로 인해",
        "으로 인해",
        "하는 것이 중요",
        "되어지",
        "에 의해"
      ],
      "blogRepeat": 5,
      "cardRepeat": 3,
      "maxNegativeSentenceRatio": 0.2,
      "maxNegativeSentenceRun": 3
    },
    "en": {
      "fixedTerms": {"Administrative Attorney": ["administrative agent", "administrative scrivener", "administrative solicitor", "administrative office"]},
      "minFleschEase": 10,
      "maxWordsPerSentence": 24,
      "proselintMax": 8
    }
  }
}
