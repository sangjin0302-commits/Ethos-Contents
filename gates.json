{
  "_note": "카드 검사 기준. 사실·렌더 무결성은 실패, 미감 관련 수치는 권고로 보고 축소 시트에서 사람이 최종 판단한다.",
  "version": "1.6",
  "calibration": "instagram-profile-advisory",
  "set": {
    "cardCount": { "min": 6, "max": 10 },
    "maxConsecutiveSameType": 2,
    "takeawayBarMaxRatio": 0.4,
    "pageNumbersSequential": true
  },
  "compositionAdvisory": {
    "minDistinctTypes": 3,
    "maxTypeShare": 0.65,
    "recommendedTypes": ["checklist", "process"]
  },
  "layout": {
    "canvasProfiles": {
      "portrait": [540, 675],
      "square": [540, 540]
    },
    "maxBottomGapPx": 48,
    "minFooterGapPx": 20,
    "mainZoneMinFillRatio": 0.4,
    "mainChildrenMax": 3,
    "zonesRequired": ["title", "main"],
    "frameTolerancePx": 0.5
  },
  "font": {
    "defaultMinPx": 14,
    "labelNoteMinPx": 12,
    "frameMinPx": 12,
    "absoluteMinPx": 12,
    "englishSemanticMinWeight": 700,
    "englishSemanticRoles": ["headline", "subheading"],
    "allowedFamilies": ["ETHOS Serif", "ETHOS Sans", "ETHOS Display"],
    "noFadedText": true
  },
  "contrast": {
    "normalMin": 4.5,
    "largeMin": 3.0,
    "largeTextPx": 24,
    "largeBoldPx": 18.66,
    "forbidGoldTextOnCream": true,
    "forbiddenColorTolerance": 2,
    "exemptFrame": true,
    "exemptDecorAttr": "data-decor"
  },
  "budget": {
    "maxCharsPerCard": 180,
    "maxHeadlineChars": 34,
    "headlineMaxLines": 2,
    "coverHeadlineMaxLines": 3,
    "paragraphMaxLines": 4,
    "byLanguage": {
      "ko": {
        "maxCharsPerCard": 180,
        "hardCharsPerCard": 240,
        "maxHeadlineChars": 34,
        "headlineMaxLines": 2,
        "coverHeadlineMaxLines": 3,
        "paragraphMaxLines": 4
      },
      "en": {
        "maxCharsPerCard": 300,
        "hardCharsPerCard": 380,
        "maxWordsPerCard": 48,
        "hardWordsPerCard": 64,
        "maxHeadlineChars": 54,
        "maxHeadlineWords": 9,
        "headlineMaxLines": 3,
        "coverHeadlineMaxLines": 4,
        "paragraphMaxLines": 4
      }
    }
  },
  "style": {
    "noGradient": true,
    "noEmoji": true,
    "forbiddenSymbols": ["+", "=", "≠"],
    "symbolApprovedAttr": "data-symbol-ok"
  },
  "content": {
    "forbiddenStrings": ["출처 입력", "http", "www.", "@", "카카오톡", "텔레그램", "이메일", "톡톡", "무료 상담", "모르면 손해", "무조건", "100%", "충격", "당장 확인", "최고", "leading", "top expert"],
    "factLock": {
      "enabled": true,
      "patterns": [
        "제\\d+조(?:의\\d+)?(?:제\\d+항)?",
        "\\d{4}도\\d+",
        "\\d[\\d,\\.]*\\s?(?:조|천|만|억|건|원|%|개|일|년|월|장|명)"
      ]
    }
  },
  "humanChecks": [
    "법령·판례 해석이 원문과 일치하는가 (변호사·행정사 최종 확인)",
    "sheet-270.png 크기에서 표지가 2초 안에 대상·문제·정보 보상 중 둘 이상을 전달하는가",
    "제목·본문·근거·결론의 위계가 한눈에 구분되는가",
    "상단과 하단의 시각 무게가 한쪽으로 몰리지 않고 여백이 의도적으로 보이는가",
    "영문 카드가 번역문을 밀어 넣은 느낌 없이 자연스러운 호흡으로 읽히는가",
    "세트 전체가 같은 박스 구조를 반복하지 않고 메시지에 맞는 시각 리듬을 갖는가",
    "원문의 또는/그리고/~수 있다 뉘앙스가 카드에서 바뀌지 않았는가",
    "마지막 장 CTA 문구가 마스터 지침의 무료 검토 안내와 일치하는가",
    "카드 한 장이 한 가지 메시지만 전달하는가"
  ]
}
