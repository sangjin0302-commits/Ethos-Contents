{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ETHOS card-data",
  "type": "object",
  "required": ["contentId", "series", "issue", "totalPages", "angle", "canvasProfile", "visualFamily", "editorialReview", "cards"],
  "properties": {
    "contentId": { "type": "string" },
    "language": { "enum": ["ko", "en"] },
    "sourceLanguage": { "enum": ["ko", "en"] },
    "translationOf": { "type": "string", "description": "대응하는 다른 언어 card-data 파일 경로" },
    "series": { "type": "string" },
    "coverLabel": { "type": "string", "description": "표지 칩에 표시할 짧은 주제 라벨. 없으면 series 사용" },
    "canvasProfile": { "enum": ["square", "portrait"], "description": "portrait는 Instagram 피드 권장 4:5(1080×1350), square는 범용 1:1" },
    "visualFamily": { "enum": ["editorial", "social-native"], "description": "social-native는 브랜드를 유지하면서 카드별 호흡과 비대칭 리듬을 강화" },
    "issue": { "type": "string", "description": "예: No.06 (사용자 확정 값)" },
    "totalPages": { "type": "integer", "minimum": 6, "maximum": 10 },
    "angle": { "type": "string" },
    "marketing": {
      "type": "object",
      "description": "발행을 막지 않는 마케팅 편집 메타데이터",
      "properties": {
        "targetReader": { "type": "string" },
        "readerQuestion": { "type": "string" },
        "practicalPayoff": { "type": "string" },
        "coverIntent": { "type": "string" },
        "saveValue": { "type": "string" },
        "ctaInputs": { "type": "array", "items": { "type": "string" } },
        "ctaOutcomes": { "type": "array", "items": { "type": "string" } },
        "performanceHypothesis": { "type": "string" }
      }
    },
    "editorialReview": {
      "type": "object",
      "description": "자연 초안과 분리된 검수 단계의 실제 완료 기록. 새 세트는 pipelineVersion 2.0을 사용",
      "required": ["pipelineVersion", "naturalDraft", "factCheck", "marketingPass", "forbiddenExpressionPass", "languagePass", "semanticRecheck"],
      "properties": {
        "pipelineVersion": { "enum": ["2.0", "legacy"] },
        "naturalDraft": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "factCheck": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "marketingPass": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "forbiddenExpressionPass": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "languagePass": { "enum": ["humanize-korean", "manual-equivalent", "english-localization", "pending", "legacy-unrecorded"] },
        "semanticRecheck": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "reviewNote": { "type": "string" }
      }
    },
    "omittedSections": { "type": "array", "items": { "type": "string" } },
    "approvedBy": { "type": "string", "description": "사용자 승인 표시. 없으면 렌더 금지" },
    "cards": {
      "type": "array", "minItems": 6, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["page", "type", "bg", "oneMessage", "headline", "sourceTrace"],
        "properties": {
          "page": { "type": "integer" },
          "type": { "enum": ["cover", "concept", "comparison", "process", "checklist", "quote", "cta"] },
          "bg": { "enum": ["navy", "cream"] },
          "oneMessage": { "type": "string" },
          "headline": { "type": "string" },
          "visualBeat": { "enum": ["calm", "bold", "evidence", "toolkit"], "description": "카드의 시각 역할. 미지정 시 type에서 안전한 기본값 선택" },
          "body": { "type": "array", "items": { "type": "string" } },
          "takeaway": { "type": "string" },
          "pageTurn": { "type": "string", "description": "카드 간 논리 흐름 검토용 메타데이터. 이미지에는 렌더하지 않음" },
          "sourceTrace": {
            "type": "object",
            "required": ["heading", "evidence"],
            "properties": {
              "heading": { "type": "string" },
              "paragraph": { "type": "string" },
              "evidence": { "enum": ["F", "I", "S"], "description": "Fact / Interpretation / Structure" },
              "compressionNote": { "type": "string" },
              "omittedQualification": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
