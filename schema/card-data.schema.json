{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ETHOS card-data",
  "type": "object",
  "required": ["contentId", "series", "issue", "totalPages", "angle", "canvasProfile", "visualFamily", "editorialReview", "cards"],
  "definitions": {
    "icon": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "assets/icons/lucide 의 파일 이름(확장자 제외). 사용 기록은 content/<ID>/assets.md" }
  },
  "properties": {
    "contentId": { "type": "string" },
    "language": { "enum": ["ko", "en"] },
    "sourceLanguage": { "enum": ["ko", "en"] },
    "translationOf": { "type": "string", "description": "대응하는 다른 언어 card-data 파일 경로" },
    "series": { "type": "string" },
    "coverLabel": { "type": "string", "description": "표지 칩에 표시할 짧은 주제 라벨. 없으면 series 사용" },
    "canvasProfile": { "enum": ["square", "portrait"], "description": "portrait는 Instagram 피드 권장 4:5(1080×1350), square는 범용 1:1" },
    "visualFamily": { "enum": ["editorial", "social-native"], "description": "social-native는 브랜드를 유지하면서 카드별 호흡과 비대칭 리듬을 강화" },
    "issue": { "type": "string", "description": "예: No.06 (사용자 확정 값)" },
    "totalPages": { "type": "integer", "minimum": 6, "maximum": 10 },
    "angle": { "type": "string" },
    "layoutVersion": { "enum": ["2"], "description": "편집 기록과 별개로 v2 레이아웃(밀도 보정·일러스트)을 켠다. legacy 승인 세트를 문구 변경 없이 새 레이아웃으로 다시 렌더할 때 쓴다" },
    "marketing": {
      "type": "object",
      "description": "발행을 막지 않는 마케팅 편집 메타데이터",
      "properties": {
        "targetReader": { "type": "string" },
        "readerQuestion": { "type": "string" },
        "practicalPayoff": { "type": "string" },
        "coverIntent": { "type": "string" },
        "saveValue": { "type": "string" },
        "ctaInputs": { "type": "array", "items": { "type": "string" } },
        "ctaOutcomes": { "type": "array", "items": { "type": "string" } },
        "performanceHypothesis": { "type": "string" }
      }
    },
    "editorialReview": {
      "type": "object",
      "description": "자연 초안과 분리된 검수 단계의 실제 완료 기록. 새 세트는 pipelineVersion 2.0을 사용",
      "required": ["pipelineVersion", "naturalDraft", "factCheck", "marketingPass", "forbiddenExpressionPass", "languagePass", "semanticRecheck"],
      "properties": {
        "pipelineVersion": { "enum": ["2.0", "legacy"] },
        "naturalDraft": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "factCheck": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "marketingPass": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "forbiddenExpressionPass": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "languagePass": { "enum": ["humanize-korean", "manual-equivalent", "english-localization", "pending", "legacy-unrecorded"] },
        "semanticRecheck": { "enum": ["pass", "pending", "legacy-unrecorded"] },
        "reviewNote": { "type": "string" }
      }
    },
    "omittedSections": { "type": "array", "items": { "type": "string" } },
    "approvedBy": { "type": "string", "description": "사용자 승인 표시. 없으면 렌더 금지" },
    "cards": {
      "type": "array", "minItems": 6, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["page", "type", "bg", "oneMessage", "headline", "sourceTrace"],
        "properties": {
          "page": { "type": "integer" },
          "type": { "enum": ["cover", "concept", "comparison", "process", "checklist", "quote", "cta", "flow", "table"] },
          "bg": { "enum": ["navy", "cream"] },
          "oneMessage": { "type": "string" },
          "headline": { "type": "string" },
          "visualBeat": { "enum": ["calm", "bold", "evidence", "toolkit"], "description": "카드의 시각 역할. 미지정 시 type에서 안전한 기본값 선택" },
          "body": {
            "type": "array",
            "description": "항목은 문자열 또는 {key, text}. key가 있으면 렌더러가 제목·라벨 열로 쓰므로 '제목 — 설명' 문자열 분해에 의존하지 않는다",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "required": ["text"], "properties": { "key": { "type": "string" }, "text": { "type": "string" }, "icon": { "$ref": "#/definitions/icon" } }, "additionalProperties": false }
              ]
            }
          },
          "layout": { "enum": ["questions", "thresholds", "stats", "numbered"], "description": "checklist 전용. questions=질문 그리드, thresholds=key 라벨 표, stats=큰 숫자 행, numbered=번호 목록. 미지정 시 key가 있으면 thresholds, 없으면 numbered" },
          "icon": { "$ref": "#/definitions/icon", "description": "표지 외 카드의 우상단 원형 아이콘(제목 줄 장식)" },
          "illustration": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "assets/illustrations 의 자체 제작 일러스트 이름. 표지는 coverStyle:panel 일 때, 그 외 카드는 본문이 짧을 때(v2.0 밀도 보정) 제목 아래에 들어간다" },
          "coverStyle": { "enum": ["art", "panel", "stat"], "description": "cover 전용. art=아이콘 원(기본), panel=일러스트 패널, stat=큰 숫자(hero)" },
          "highlight": { "type": "string", "description": "강조할 구절. 이 카드 headline 또는 takeaway 안의 정확한 부분 문자열. 골드 밑줄로 렌더" },
          "design": { "type": "string", "description": "자유 디자인(B)용 한 줄 제안: 이 카드의 시각 중심과 구도. 렌더 문구가 아니다" },
          "hero": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } }, "additionalProperties": false, "description": "coverStyle:stat 전용. 큰 숫자와 라벨(예: 6 / 가지 질문). 숫자는 원문 근거가 있어야 한다" },
          "art": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/definitions/icon" }, "description": "cover 전용. 점선으로 이은 아이콘 원 2~3개(상황 삽화)" },
          "takeStyle": { "enum": ["bar", "close"], "description": "하단 결론 스타일. bar=박스, close=구분선 한 줄. 미지정 시 cover·cta·comparison은 bar, 나머지는 close" },
          "head": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" }, "description": "table 전용 열 제목 2개" },
          "note": { "type": "string", "description": "flow 전용. 흐름 아래에 붙는 한 줄 보충" },
          "promise": { "type": "string", "description": "cover 전용. 이 캐러셀을 끝까지 보면 얻는 것 한 줄(예: 10장 · 출시 전 6가지 질문)" },
          "takeaway": { "type": "string" },
          "pageTurn": { "type": "string", "description": "카드 간 논리 흐름 검토용 메타데이터. 이미지에는 렌더하지 않음" },
          "sourceTrace": {
            "type": "object",
            "required": ["heading", "evidence"],
            "properties": {
              "heading": { "type": "string" },
              "paragraph": { "type": "string" },
              "evidence": { "enum": ["F", "I", "S"], "description": "Fact / Interpretation / Structure" },
              "compressionNote": { "type": "string" },
              "omittedQualification": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
