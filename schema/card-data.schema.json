{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ETHOS card-data",
  "type": "object",
  "required": ["contentId", "series", "issue", "totalPages", "angle", "cards"],
  "properties": {
    "contentId": { "type": "string" },
    "language": { "enum": ["ko", "en"] },
    "sourceLanguage": { "enum": ["ko", "en"] },
    "translationOf": { "type": "string", "description": "대응하는 다른 언어 card-data 파일 경로" },
    "series": { "type": "string" },
    "coverLabel": { "type": "string", "description": "표지 칩에 표시할 짧은 주제 라벨. 없으면 series 사용" },
    "issue": { "type": "string", "description": "예: No.06 (사용자 확정 값)" },
    "totalPages": { "type": "integer", "minimum": 6, "maximum": 10 },
    "angle": { "type": "string" },
    "marketing": {
      "type": "object",
      "description": "발행을 막지 않는 마케팅 편집 메타데이터",
      "properties": {
        "targetReader": { "type": "string" },
        "coverIntent": { "type": "string" },
        "saveValue": { "type": "string" },
        "ctaInputs": { "type": "array", "items": { "type": "string" } },
        "ctaOutcomes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "omittedSections": { "type": "array", "items": { "type": "string" } },
    "approvedBy": { "type": "string", "description": "사용자 승인 표시. 없으면 렌더 금지" },
    "cards": {
      "type": "array", "minItems": 6, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["page", "type", "bg", "oneMessage", "headline", "sourceTrace"],
        "properties": {
          "page": { "type": "integer" },
          "type": { "enum": ["cover", "concept", "comparison", "process", "checklist", "quote", "cta"] },
          "bg": { "enum": ["navy", "cream"] },
          "oneMessage": { "type": "string" },
          "headline": { "type": "string" },
          "body": { "type": "array", "items": { "type": "string" } },
          "takeaway": { "type": "string" },
          "pageTurn": { "type": "string" },
          "sourceTrace": {
            "type": "object",
            "required": ["heading", "evidence"],
            "properties": {
              "heading": { "type": "string" },
              "paragraph": { "type": "string" },
              "evidence": { "enum": ["F", "I", "S"], "description": "Fact / Interpretation / Structure" },
              "compressionNote": { "type": "string" },
              "omittedQualification": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
